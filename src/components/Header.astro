---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/yh-blog/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<a href="/yh-blog/">Home</a>
			<!-- Add more links here later -->
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--white);
		box-shadow: none;
		border-bottom: 1px solid var(--border-color);
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 800px;
		margin: 0 auto;
		padding: 1.5rem 0;
	}
	nav a {
		padding: 0.5em 1em;
		color: var(--gray);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease, border-bottom-color 0.2s ease;
	}
	nav a:hover {
		color: rgb(var(--accent));
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: rgb(var(--accent));
		color: rgb(var(--black));
	}
</style>
