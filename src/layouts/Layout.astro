---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/yh-blog/blog-placeholder-1.svg' } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/yh-blog/favicon.svg" />
		<link rel="icon" href="/yh-blog/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--accent: 0, 86, 179; /* Deep Blue */
		--accent-light: 224, 240, 255;
		--accent-dark: 0, 39, 82;
		--black: 34, 34, 34;
		--gray: 102, 102, 102;
		--gray-light: 248, 249, 250;
		--gray-dark: 51, 51, 51;
		--white: 255, 255, 255;
		--border-color: 230, 230, 230;
	}
	html {
		font-family: 'Inter', 'Noto Sans JP', sans-serif;
		background: var(--white);
		color: rgb(var(--black));
		line-height: 1.8;
		letter-spacing: 0.02em;
	}
	body {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	main {
		flex: 1;
		width: 100%;
		max-width: 800px; /* Narrower width for reading */
		margin: 0 auto;
		padding: 4rem 2rem;
	}
	h1, h2, h3, h4, h5, h6 {
		margin: 0 0 1rem 0;
		color: rgb(var(--black));
		line-height: 1.3;
		font-weight: 700;
	}
	h1 {
		font-size: 2.5rem;
		letter-spacing: -0.02em;
	}
	p {
		margin-bottom: 1.5rem;
	}
	/* Customize scrollbar */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: #ddd;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #ccc;
	}
</style>
