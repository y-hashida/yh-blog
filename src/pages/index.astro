---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
	<main>
		<section>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/yh-blog/blog/${post.slug}/`}>
								<img width={720} height={360} src={post.data.heroImage || '/yh-blog/blog-placeholder-1.svg'} alt="" />
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									{post.data.pubDate.toLocaleDateString('ja-JP')}
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	section {
		margin-top: 2rem;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		transition: transform 0.2s ease;
	}
	ul li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li:first-child {
		grid-column: 1 / -1;
		margin-bottom: 2rem;
		text-align: center;
	}
	ul li:first-child img {
		width: 100%;
		max-height: 500px;
		object-fit: cover;
	}
	ul li:first-child .title {
		font-size: 2.5rem;
		margin-top: 1rem;
	}
	ul li img {
		width: 100%;
		height: auto;
		aspect-ratio: 16/9;
		object-fit: cover;
		margin-bottom: 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--border-color);
	}
	ul li a {
		display: block;
	}
	.title {
		margin: 0.5rem 0 0.2rem 0;
		color: rgb(var(--black));
		line-height: 1.4;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.date {
		margin: 0;
		color: var(--gray);
		font-size: 0.9rem;
		font-family: 'Inter', sans-serif;
	}
	ul li a:hover .title {
		color: rgb(var(--accent));
	}
	ul li a:hover img {
		border-color: rgb(var(--accent));
		opacity: 0.9;
	}
	@media (max-width: 720px) {
		ul {
			gap: 1.5rem;
		}
		ul li:first-child {
			margin-bottom: 1rem;
		}
		ul li:first-child .title {
			font-size: 1.8rem;
		}
	}
</style>
