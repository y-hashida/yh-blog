---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
	<main>
		<section>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/yh-blog/blog/${post.slug}/`}>
								<div class="card-content">
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										{post.data.pubDate.toLocaleDateString('ja-JP')}
									</p>
									<p class="description">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	section {
		margin-top: 2rem;
	}
	ul {
		display: grid;
		grid-template-columns: 1fr; /* Single column for better readability of text-only cards */
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		transition: transform 0.2s ease;
	}
	ul li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li a {
		display: block;
		padding: 2rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		background: var(--white);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.title {
		margin: 0 0 0.5rem 0;
		color: rgb(var(--black));
		line-height: 1.3;
		font-size: 1.5rem;
		font-weight: 700;
	}
	.date {
		margin: 0 0 1rem 0;
		color: var(--gray);
		font-size: 0.9rem;
		font-family: 'Inter', sans-serif;
	}
	.description {
		margin: 0;
		color: var(--gray-dark);
		line-height: 1.6;
	}
	ul li a:hover {
		border-color: rgb(var(--accent));
		transform: translateY(-2px);
	}
	ul li a:hover .title {
		color: rgb(var(--accent));
	}
	@media (max-width: 720px) {
		ul {
			gap: 1.5rem;
		}
		ul li a {
			padding: 1.5rem;
		}
		.title {
			font-size: 1.3rem;
		}
	}
</style>
