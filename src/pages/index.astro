---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
	<main>
		<section>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/yh-blog/blog/${post.slug}/`}>
								<div class="card-content">
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										{post.data.pubDate.toLocaleDateString('ja-JP')}
									</p>
									<p class="description">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	section {
		margin-top: 2rem;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 0;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		border-bottom: 1px solid var(--border-color);
		transition: background-color 0.2s ease;
	}
	ul li:last-child {
		border-bottom: none;
	}
	ul li a {
		display: block;
		padding: 2rem 1.5rem;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	ul li a:hover {
		background-color: var(--gray-light);
	}
	.title {
		margin: 0 0 0.5rem 0;
		color: rgb(var(--black));
		line-height: 1.4;
		font-size: 1.4rem;
		font-weight: 700;
		transition: color 0.2s ease;
	}
	ul li a:hover .title {
		color: rgb(var(--accent));
	}
	.date {
		margin: 0 0 0.5rem 0;
		color: var(--gray);
		font-size: 0.85rem;
		font-family: 'Inter', sans-serif;
	}
	.description {
		margin: 0;
		color: var(--gray-dark);
		line-height: 1.6;
		font-size: 1rem;
	}
	@media (max-width: 720px) {
		ul li a {
			padding: 1.5rem 1rem;
		}
		.title {
			font-size: 1.2rem;
		}
	}
</style>
